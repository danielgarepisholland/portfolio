{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-04-30",
  // Static-assets-only Worker: no main script. dist/ is generated by copying
  // the site files (see README / Builds settings); it is not committed.
  "assets": {
    "directory": "./dist"
  }
}
